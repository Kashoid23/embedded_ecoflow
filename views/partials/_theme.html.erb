<%# Dark "control room" theme shared by every page.
    System fonts only, so the screen works without internet access. %>
<style>
  :root {
    --bg: #0e1116; --card: #151a21; --card-2: #1c222b; --line: #252b35; --track: #1f252e;
    --text: #e8ebf0; --muted: #9aa4b2; --faint: #7c8594; --accent: #5b9cff;
    --ok: #4ade80; --ok-fill: #2f9e6a; --ok-bg: #12301f;
    --bad: #ff8a8a; --bad-fill: #f06565; --bad-bg: #3a1d21;
    --warn-fill: #e8a33a;
    --plan: #f5b83d; --plan-text: #f5c46b; --plan-bg: #3a2e18;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); }
  body { font: 15px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: var(--text); }
  a { color: var(--accent); } a:hover { color: #8dbaff; }

  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
  .muted { color: var(--muted); }
  .mono { font-family: var(--mono); }
  .ok { color: var(--ok); } .bad { color: var(--bad); }

  .chip { display: inline-block; font-size: 12px; font-weight: 600; padding: 2px 10px; border-radius: 99px; white-space: nowrap; }
  .chip.ok { background: var(--ok-bg); color: var(--ok); }
  .chip.bad { background: var(--bad-bg); color: var(--bad); }
  .chip.muted { background: var(--card-2); color: var(--muted); }

  .kpi .label { font-size: 12px; color: var(--muted); }
  .kpi .value { font-weight: 700; font-variant-numeric: tabular-nums; }
  .kpi .sub { font-size: 12px; color: var(--muted); }

  /* 24-hour timeline */
  .timeline { display: flex; flex-direction: column; gap: 8px; }
  .timeline .track { position: relative; flex: none; height: 24px; background: var(--track); border-radius: 6px; overflow: hidden; }
  .timeline .note { position: absolute; inset: 0; display: grid; place-items: center; font-size: 12px; color: var(--faint); }
  /* Planned outages are drawn first, actual power on top of them: history replaces the plan up to now */
  .seg { position: absolute; top: 0; bottom: 0; }
  .seg.plan { background: var(--plan); }
  .seg.maybe { background: var(--plan); opacity: .45; }
  .seg.on { background: var(--ok-fill); }
  .seg.off { background: var(--bad-fill); }
  /* "Now" in each track: bright 3px line, dark edges keep it visible on any segment colour */
  .now-line { position: absolute; top: 0; bottom: 0; width: 3px; margin-left: -1.5px; z-index: 1;
              background: #fff; box-shadow: 0 0 0 1.5px var(--bg); }
  .hours { display: flex; justify-content: space-between; font: 11px var(--mono); color: var(--faint); }

  .meter { height: 8px; background: var(--track); border-radius: 99px; overflow: hidden; }
  .meter > div { height: 100%; background: var(--accent); border-radius: 99px; }
  .meter > .ok { background: var(--ok-fill); }
  .meter > .warn { background: var(--warn-fill); }
  .meter > .bad { background: var(--bad-fill); }
</style>
