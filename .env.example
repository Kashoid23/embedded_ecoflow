# --- EcoFlow Developer API ---
# Keys from developer-eu.ecoflow.com
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
# eu | us | global
ECOFLOW_REGION=
# Stations to show, comma-separated. Empty = every station on the account.
ECOFLOW_SN=
# Stations that decide whether the house has power, comma-separated. Empty = every station.
ECOFLOW_GRID_SN=
# Seconds between samples (stats are built from them)
ECOFLOW_SAMPLE_INTERVAL=60
# Page auto-refresh, seconds
ECOFLOW_INTERVAL=60

# --- Outage schedule ---
# Your group/queue, e.g. 1.1. Empty = no schedule on the dashboard.
OUTAGE_GROUP=
# Required with OUTAGE_GROUP: a file name (without .json) from
# github.com/yaroslav2901/OE_OUTAGE_DATA/tree/main/data
OBLENERGO=

# --- Weather (open-meteo.com). Empty = no weather in the header ---
WEATHER_LAT=
WEATHER_LON=

# --- Server ---
PORT=
# 0.0.0.0 to open from other devices on your network
BIND=
# Debug shows every API request
LOG_LEVEL=
# env
APP_ENV=

# --- Air-raid siren ---
# Provider: alerts_in_ua (token on request: api@alerts.in.ua; region = oblast uid)
#        or ukrainealarm (API key on request at api.ukrainealarm.com; region = district/community
#        regionId: oblast ids no longer report alerts). Empty = no siren icon.
AIR_RAID_PROVIDER=
AIR_RAID_TOKEN=
# The provider's own region id (ids differ between providers)
AIR_RAID_REGION=
