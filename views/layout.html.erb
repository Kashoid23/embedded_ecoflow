<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ecoflow Dashboard</title>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0e1116">
  <%= partial(:theme) %>
  <style>
    main { max-width: 1200px; margin: 0 auto; padding: 24px clamp(12px, 3vw, 40px); display: flex; flex-direction: column; gap: 16px; }
    .page-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
    .pill { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; font-size: 13px; }
    h2 { margin: 0; font-size: 14px; font-weight: 600; }
    .sn { color: var(--muted); font: 11px var(--mono); }
    .error { color: var(--bad); font-size: 14px; }
    a.back { text-decoration: none; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { text-align: left; font-weight: 500; font-size: 12px; color: var(--muted); }
    th, td { padding: 12px 16px; border-bottom: 1px solid var(--line); vertical-align: middle; }
    tr:last-child td { border-bottom: 0; }
    td.key { font: 12px var(--mono); white-space: nowrap; }
    td.val { word-break: break-all; font-variant-numeric: tabular-nums; }
    input[type=search] { width: 100%; padding: 10px 12px; font-size: 15px; color: var(--text);
                         background: var(--card); border: 1px solid var(--line); border-radius: 8px; }
  </style>
</head>
<body>
  <main>
    <%= content %>
  </main>
</body>
</html>
